    family-names: "C. Chulvi"
    affiliation: "Offlined"
    website: "https://www.offlined.org"
repository-code: "https://github.com/Aruvaro-Chulvi/OfflinedSeaCharts"
url: "https://www.offlined.org"
license: ODbL-1.0
keywords:
  - OpenStreetMap
  - seamarks
  - nautical charts
  - OpenSeaMap
  - offline
  - Offlined
references:
